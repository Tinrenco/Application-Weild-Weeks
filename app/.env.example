# Copy to app/.env.local (not committed).
#
# URL of the API, as seen FROM THE PHONE.
# - Android emulator:         http://10.0.2.2:3000/api
# - iOS simulator / Expo web: http://localhost:3000/api
# - Real phone with Expo Go:  http://<your computer's IP on the Wi-Fi>:3000/api
#   (Windows: `ipconfig`, look for "IPv4 Address"; phone and computer on the same network)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
