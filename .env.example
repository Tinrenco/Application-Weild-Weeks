# Copy to .env (same folder) to override the defaults of docker-compose.yml.
# Dev values only. The production .env lives on the ViaRézo server, never in Git.

POSTGRES_USER=wei
POSTGRES_PASSWORD=wei
POSTGRES_DB=wei

# Generate a real one in production: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-dev-secret-change-me

# Fake login while waiting for the ViaRézo OAuth client. MUST be false in production.
DEV_LOGIN_ENABLED=true

# Log in with ViaRézo — see api/.env.example for what each value means.
VIAREZO_CLIENT_ID=
VIAREZO_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:3000/api
APP_RETURN_URLS=weildweeks://,exp://,http://localhost:8081/
