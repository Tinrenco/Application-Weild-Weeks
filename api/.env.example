# Copy this file to api/.env to run the API outside Docker (npm run dev).
# Values below are for local development only.

# Points to the "db" container exposed on localhost by docker-compose.
DATABASE_URL="postgresql://wei:wei@localhost:5432/wei"

PORT=3000

# Secret used to sign session tokens. Any long random string in dev;
# generate a real one in production, e.g. `openssl rand -hex 32`.
JWT_SECRET="dev-secret-change-me-dev-secret-change-me"

# Fake login (pick a test user) while we wait for the ViaRézo OAuth client.
# MUST be false in production.
DEV_LOGIN_ENABLED=true

# --- Log in with ViaRézo (see api/src/auth/viarezo.ts) ---
# Create a client on https://moncompte.viarezo.fr/developer with:
#   scopes: openid, profile, email   grant: authorization_code
#   redirect URI: exactly PUBLIC_API_URL + "/auth/viarezo/callback"
# Leave the id/secret empty to disable the ViaRézo button (dev login still works).
# NEVER commit the real secret: it only goes in your local .env and on the server.
VIAREZO_CLIENT_ID=""
VIAREZO_CLIENT_SECRET="9c74bde381741fa05578cfe669a27747822dd526"

# Public URL of the API, as seen by the browser that does the login.
# - Expo web preview on this computer: http://localhost:3000/api
# - Real phone with Expo Go: http://<your computer's IP>:3000/api (same as the app's
#   EXPO_PUBLIC_API_URL), and register THAT callback URL on moncompte.viarezo.fr too.
PUBLIC_API_URL="http://localhost:3000/api"

# Where the API may send users back after login. Production: weildweeks:// only.
APP_RETURN_URLS="weildweeks://,exp://,http://localhost:8081/"
